# Copy to `.env` (git-ignored) and fill in what you need. All values are optional
# except an LLM key for LLM-based distillation, topic naming, matching and planning.

# LLM provider: openai, copilot, or an ordered fallback list such as openai,copilot.
# Unset uses OpenAI when a key is set.
# PAPERATLAS_LLM_PROVIDER=openai
# OpenAI (Responses API compatible)
OPENAI_API_KEY=
# PAPERATLAS_LLM_MODEL=gpt-5.2
# PAPERATLAS_LLM_BASE_URL=https://api.openai.com/v1
# GitHub Copilot CLI (no key needed)
# PAPERATLAS_COPILOT_LLM_MODEL=
# Applied to every Copilot CLI call (LLM and builder): default|long_context, none..max
# PAPERATLAS_COPILOT_CONTEXT=
# PAPERATLAS_COPILOT_REASONING_EFFORT=

# Storage (PostgreSQL 18 + pgvector)
# PAPERATLAS_DATABASE_URL=postgresql+psycopg://localhost/paperatlas

# Research sources (all optional; recommended for reliable discovery)
# PAPERATLAS_S2_API_KEY=            # Semantic Scholar (rate-limited without a key)
# PAPERATLAS_OPENALEX_API_KEY=      # OpenAlex (tiny shared budget without a key)
# PAPERATLAS_CONTACT_EMAIL=         # sent to OpenAlex as mailto
# PAPERATLAS_USPTO_API_KEY=         # USPTO Open Data Portal; patents are skipped without it
# GITHUB_TOKEN=                     # engineering sources (lab.yaml `upstream`); else GH_TOKEN, PAPERATLAS_GITHUB_TOKEN
#                                   # or `gh auth token`; without one GitHub allows 60 requests/hour, 10 searches/min

# Coding agent used to implement techniques: copilot (default) or codex
# PAPERATLAS_BUILDER=copilot
# PAPERATLAS_BUILDER_MODEL=

# Services
# PAPERATLAS_GATEWAY_PORT=8100
# PAPERATLAS_RESEARCH_PORT=8101
# PAPERATLAS_LAB_PORT=8102
# PAPERATLAS_WORKER_CONCURRENCY=3
